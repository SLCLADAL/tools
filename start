#!/bin/bash
# ============================================================
#  start — tools-env Binder start script
#
#  Runs BEFORE JupyterLab opens. Pre-executes whichever launcher
#  notebook was requested so the Shiny app is already starting
#  (or ready) when the user sees the page.
#
#  Place this file at the root of the tools-env repo as: start
#  Make it executable: chmod +x start
# ============================================================

# Do NOT use set -e here — if any pre-launch step fails we must
# still reach the final `exec jupyter lab` or Binder returns
# "Internal Server Error" (the container starts but JupyterLab
# never launches).

TOOLS_DIR="${HOME}/tools"

# ── Determine which launcher was requested ──────────────────
# nbgitpuller encodes the notebook path in the urlpath query string.
# Binder/JupyterHub exposes this via several possible env variables.

LAUNCHER_NB=""

for VAR in JUPYTER_NOTEBOOK_PATH JUPYTERHUB_NOTEBOOK_PATH NB_PREFIX; do
  VAL="${!VAR}"
  if [[ "$VAL" == *"_launcher"* ]]; then
    LAUNCHER_NB="${TOOLS_DIR}/$(basename "$VAL")"
    break
  fi
done

# ── Pre-execute the launcher notebook (non-fatal) ───────────
if [[ -z "$LAUNCHER_NB" ]]; then
  echo "[start] Could not detect launcher from env — skipping pre-execution."
  echo "[start] User can run the cell manually with Shift+Enter."
elif [[ ! -f "$LAUNCHER_NB" ]]; then
  echo "[start] Launcher not found at $LAUNCHER_NB — skipping."
else
  echo "[start] Pre-executing launcher: $LAUNCHER_NB"
  jupyter nbconvert \
    --to notebook \
    --execute \
    --ExecutePreprocessor.timeout=120 \
    --inplace \
    "$LAUNCHER_NB" \
    && echo "[start] ✔ Launcher executed successfully." \
    || echo "[start] ⚠ Launcher execution failed — user can run the cell manually."
fi

# ── Start JupyterLab ─────────────────────────────────────────
# Pass through all arguments Binder/repo2docker provides via "$@".
# Do NOT hardcode --ip, --no-browser, or --NotebookApp/--ServerApp
# flags here — repo2docker sets these via environment variables and
# passing them again can cause "Internal Server Error" on launch.
echo "[start] Starting JupyterLab..."
exec jupyter lab "$@"
